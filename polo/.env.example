# Copia este archivo a ".env" y ajusta los valores.
# El archivo .env NO se sube al repositorio (esta en .gitignore).

# Nivel de detalle de los logs: DEBUG, INFO, WARNING, ERROR.
POLO_LOG_LEVEL=INFO

# -- LLM (Fase 1) --
POLO_LLM_PROVIDER=ollama
POLO_OLLAMA_HOST=http://localhost:11434
POLO_OLLAMA_MODEL=qwen2.5:3b
# Mantener el modelo caliente en RAM (evita recargas lentas).
POLO_OLLAMA_KEEP_ALIVE=30m

# -- Memoria de largo plazo (Fase 2) --
# Modelo para embeddings. Descargalo con: ollama pull nomic-embed-text
POLO_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Cuantos recuerdos relevantes recuperar por turno.
POLO_MEMORY_RECALL_K=5
# Extraer memoria automaticamente tras cada intercambio (true/false).
# Ponlo en false si preferis que POLO solo recuerde cuando se lo pidas.
POLO_MEMORY_AUTO_EXTRACT=false

# -- Plugins (Fase 4) --
# Si POLO carga plugins desde ~/.polo/plugins. Ponlo en false para desactivarlos.
POLO_PLUGINS_ENABLED=true

# -- Voz (Fase 5) --
# Si POLO responde en voz alta (ademas de por texto). Ponlo en true para activarlo.
POLO_VOICE_OUTPUT_ENABLED=false
# Velocidad de la voz (palabras por minuto aprox.).
POLO_VOICE_RATE=170

# -- Vision (Fase 6) --
# Modelo de vision de Ollama. Descargalo con: ollama pull llava
# Alternativas: moondream (rapido), qwen2.5vl (mejor espanol).
POLO_OLLAMA_VISION_MODEL=llava

# -- Automatizacion (Fase 7) --
# Interruptor maestro. Las acciones riesgosas igual piden confirmacion.
# Ponlo en false para quitarle a POLO toda capacidad de tocar tu sistema.
POLO_AUTOMATION_ENABLED=true

# -- Voz neuronal Kokoro (opcional, Fase 5) --
# Motor de voz: "pyttsx3" (voz del sistema) o "kokoro" (neuronal, mas natural).
POLO_VOICE_ENGINE=pyttsx3
# Rutas a los archivos del modelo Kokoro (solo si usas kokoro). Ver README.
POLO_KOKORO_MODEL_PATH=
POLO_KOKORO_VOICES_PATH=
POLO_KOKORO_VOICE=ef_dora
POLO_KOKORO_LANG=es
# Voz Magpie de NVIDIA (nube, misma API key). Pone POLO_VOICE_ENGINE=nim.
POLO_NIM_TTS_VOICE=Magpie-Multilingual.ES-US.Isabela
POLO_NIM_TTS_LANGUAGE=es-US
# Voz de la GUI web: "browser" o "nim" (Magpie del servidor).
POLO_WEB_TTS=browser

# -- Escucha por voz / STT (opcional, Fase 5 Paso B) --
# Si POLO te escucha por microfono (Enter vacio = grabar).
POLO_VOICE_INPUT_ENABLED=false
# Modelo Whisper: tiny (rapido), base, small (mejor calidad).
POLO_WHISPER_MODEL=base
POLO_STT_LANGUAGE=es
# Cuantos segundos graba cada vez que hablas.
POLO_STT_SILENCE_THRESHOLD=0.02
POLO_STT_SILENCE_SECONDS=1.2
POLO_STT_START_TIMEOUT=4
POLO_STT_MAX_SECONDS=20

# -- Cerebro en la nube / NIM (opcional) --
# "ollama" (local) o "nim" (nube NVIDIA, rapido; Ollama queda de respaldo).
POLO_LLM_BACKEND=ollama
POLO_NIM_API_KEY=
POLO_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Eleji un modelo que soporte function calling (Llama 3.1/3.3 70B, Nemotron...).
POLO_NIM_MODEL=meta/llama-3.1-70b-instruct
# Embeddings: "ollama" (local) o "nim" (nube, mas rapido por mensaje).
POLO_EMBEDDING_BACKEND=ollama
POLO_NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# -- Spotify (opcional, requiere Premium) --
# Crea una app en developer.spotify.com, pega client id y secret aca.
POLO_SPOTIFY_ENABLED=false
POLO_SPOTIFY_CLIENT_ID=
POLO_SPOTIFY_CLIENT_SECRET=
POLO_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# -- YouTube (opcional) --
# Sin key, POLO abre la busqueda. Con una API key (YouTube Data API v3,
# gratis en Google Cloud), reproduce el primer video directo.
POLO_YOUTUBE_API_KEY=

# -- Panel HUD de la GUI --
# Ciudad para mostrar el clima en el panel (vacio = no mostrar). Ej: Montevideo
POLO_DASHBOARD_CITY=
